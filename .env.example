OPENAI_API_KEY=
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
HUGGINGFACE_TOKEN=
OPENALEX_EMAIL=

RESEARCH_DAYS=7
TOP_PAPERS=10
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,stat.ML
DRY_RUN=true

WEEKLY_MIN_SCORE=70
WEEKLY_MAX_PAPERS=10
